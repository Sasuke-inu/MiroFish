# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# Existing Cloud installations keep GRAPH_PROVIDER=zep.
# The local Docker installation uses graphiti and needs no Zep account.
GRAPH_PROVIDER=zep
GRAPHITI_BASE_URL=http://graphiti:5010
GRAPHITI_API_KEY=replace_with_a_random_local_service_key
NEO4J_PASSWORD=replace_with_a_random_database_password
GRAPHITI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional self-hosted Firecrawl input collection (no automatic Cloud fallback).
# Native backend: http://127.0.0.1:3002; local Docker: http://host.docker.internal:3002
FIRECRAWL_ENABLED=false
FIRECRAWL_BASE_URL=http://127.0.0.1:3002
FIRECRAWL_API_KEY=
# These can be lowered. Hard ceilings: 3 pages per job, 10 attempts per day.
FIRECRAWL_MAX_PAGES_PER_JOB=3
FIRECRAWL_DAILY_PAGE_LIMIT=10
FIRECRAWL_BUDGET_TIMEZONE=Australia/Sydney

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
