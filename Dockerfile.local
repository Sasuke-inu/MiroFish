FROM node:22-bookworm-slim AS frontend-build
WORKDIR /app/frontend
ENV npm_config_fund=false npm_config_audit=false
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY locales/ /app/locales/
ENV VITE_API_BASE_URL=/
RUN npm run build

FROM nginx:stable-alpine AS frontend
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80

FROM python:3.11-slim-bookworm AS backend
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 \
    DO_NOT_TRACK=1 HF_HUB_DISABLE_TELEMETRY=1 \
    ANONYMIZED_TELEMETRY=False OTEL_SDK_DISABLED=true \
    SCARF_NO_ANALYTICS=true LANGFUSE_ENABLED=false LANGFUSE_TRACING_ENABLED=false \
    GRAPHITI_TELEMETRY_ENABLED=false
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libcairo2 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
COPY backend/vendor/ ./vendor/
RUN uv sync --frozen --no-install-project
COPY locales/ /app/locales/
COPY backend/ ./
RUN uv sync --frozen
ENV PATH="/app/backend/.venv/bin:$PATH"
EXPOSE 5001
CMD ["python", "serve.py"]
