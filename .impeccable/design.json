  "components": [
    {
      "name": "開始分析按鈕",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "首頁的主要動作；保留準備來源、執行中與不可送出狀態。",
      "html": "<button class=\"ds-primary\" type=\"button\"><span>開始分析</span><svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 10h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;justify-content:center;align-items:center;gap:20px;min-height:48px;min-width:145px;padding:12px 18px;border:0;border-radius:9px;background:var(--studio-button,#34392d);color:var(--theme-on-filled,#f5efdf);font-size:1rem;line-height:1.5;font-weight:600;cursor:pointer;font-family:var(--studio-font,system-ui,sans-serif);}.ds-primary svg{width:18px;height:18px;stroke:currentColor;stroke-width:1.5}.ds-primary:hover:not(:disabled){background:var(--studio-button-hover,#474e3c)}.ds-primary:disabled{background:var(--theme-surface-soft,#d9d5c9);color:var(--studio-muted,#515548);cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid var(--studio-accent,#805014);outline-offset:3px;}"
    },
    {
      "name": "設定次要按鈕",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "設定與偏好控制使用有邊框的次要按鈕，文字與圖示並列。",
      "html": "<button class=\"ds-secondary\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m9.5 3-.6 2.1-2 .9-2-.6-2.4 4.2L4 11v2l-1.5 1.4L5 18.6l2-.6 2 .9.6 2.1h4.8l.6-2.1 2-.9 2 .6 2.4-4.2L20 13v-2l1.5-1.4L19 5.4l-2 .6-2-.9-.6-2.1Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg><span>設定</span></button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;padding:8px 10px;border:1px solid var(--studio-line,#b4b1a3);border-radius:8px;background:var(--studio-surface,#e4ded2);color:var(--studio-muted,#515548);font-size:13px;white-space:nowrap;cursor:pointer;font-family:var(--studio-font,system-ui,sans-serif);}.ds-secondary svg{width:17px;height:17px;stroke:currentColor;stroke-width:1.7}.ds-secondary:hover{color:var(--studio-accent,#805014);border-color:var(--studio-accent,#805014);background:var(--studio-soft,#e8d8b9)}.ds-secondary:focus-visible{outline:3px solid var(--studio-accent,#805014);outline-offset:3px;}"
    },
    {
      "name": "文字導覽按鈕",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "歷史紀錄等低強度導覽使用純文字；保持完整點選範圍。",
      "html": "<button class=\"ds-ghost\" type=\"button\">歷史紀錄</button>",
      "css": ".ds-ghost{min-height:44px;display:inline-flex;align-items:center;padding:8px 0;border:0;background:none;color:var(--studio-muted,#515548);font-size:.875rem;font-weight:500;cursor:pointer;font-family:var(--studio-font,system-ui,sans-serif);}.ds-ghost:hover{color:var(--studio-accent,#805014)}.ds-ghost:focus-visible{outline:3px solid var(--studio-accent,#805014);outline-offset:3px;}"
    },
    {
      "name": "網址輸入框",
      "kind": "input",
      "refersTo": "field-source",
      "description": "兩行網址輸入區與常駐用途說明；準備來源時沿用停用與進度提示。",
      "html": "<div class=\"ds-source-field\"><label class=\"ds-source-label\" for=\"ds-source-url\">貼上網頁網址</label><textarea class=\"ds-source-input\" id=\"ds-source-url\" rows=\"2\" placeholder=\"https://example.com/article\" spellcheck=\"false\" aria-describedby=\"ds-source-help\"></textarea><p class=\"ds-source-help\" id=\"ds-source-help\">開始分析時會自動讀取並加入資料。</p></div>",
      "css": ".ds-source-field{min-width:0;font-family:var(--studio-font,system-ui,sans-serif);}.ds-source-label{display:block;font-size:.875rem;line-height:1.65;font-weight:600;margin-bottom:8px;color:var(--studio-ink,#282b25)}.ds-source-input{display:block;box-sizing:border-box;width:100%;min-height:80px;resize:vertical;padding:10px 13px;border:1px solid var(--theme-line-strong,#878c78);border-radius:9px;background:var(--studio-surface,#e4ded2);color:var(--studio-ink,#282b25);font:1rem/1.7 var(--studio-font,system-ui,sans-serif);caret-color:var(--studio-accent,#805014)}.ds-source-input::placeholder{color:var(--studio-muted,#515548)}.ds-source-input:disabled{opacity:.7}.ds-source-help{font-size:.875rem;color:var(--studio-muted,#515548);line-height:1.75;margin:7px 0 0}.ds-source-input:focus-visible{outline:2px solid var(--studio-accent,#805014);outline-offset:3px;}"
    },
    {
      "name": "設定頁分區導覽",
      "kind": "nav",
      "refersTo": "nav-settings-active",
      "description": "目前分區以表面底色、邊框、字重與琥珀側線共同呈現。",
      "html": "<nav class=\"ds-settings-nav\" aria-label=\"設定分區\"><button class=\"ds-settings-item ds-settings-active\" type=\"button\" aria-current=\"page\">模型設定</button><button class=\"ds-settings-item\" type=\"button\">外觀與語言</button></nav>",
      "css": ".ds-settings-nav{display:grid;gap:6px;max-width:240px;font-family:var(--studio-font,system-ui,sans-serif);}.ds-settings-item{display:flex;align-items:center;gap:12px;min-height:50px;padding:14px;border:1px solid transparent;border-radius:9px;background:transparent;color:var(--studio-muted,#515548);font-size:13px;text-align:left;cursor:pointer;font-family:var(--studio-font,system-ui,sans-serif);}.ds-settings-active{background:var(--studio-surface,#e4ded2);border-color:var(--studio-line,#b4b1a3);color:var(--studio-ink,#282b25);font-weight:700;box-shadow:inset 3px 0 var(--studio-accent,#805014)}.ds-settings-item:hover{color:var(--studio-ink,#282b25);background:var(--studio-surface,#e4ded2)}.ds-settings-item:focus-visible{outline:3px solid var(--studio-accent,#805014);outline-offset:3px;}"
    },
    {
      "name": "已完成狀態標籤",
      "kind": "chip",
      "refersTo": "chip-success",
      "description": "狀態以簡短文字和綠色底層一起表示；標籤本身不充當按鈕。",
      "html": "<span class=\"ds-status-chip\">已完成</span>",
      "css": ".ds-status-chip{display:inline-block;border-radius:6px;padding:5px 8px;background:var(--theme-success-surface,#d4dfcf);color:var(--studio-green,#355b40);font-size:12px;line-height:1.6;font-family:var(--studio-font,system-ui,sans-serif);}"
    },
    {
      "name": "新的探索內容卡",
      "kind": "card",
      "refersTo": "card-project",
      "description": "首頁表單使用的安靜容器；以表面色與細框分層。",
      "html": "<section class=\"ds-project-card\" aria-labelledby=\"ds-card-title\"><h3 class=\"ds-card-title\" id=\"ds-card-title\"><span class=\"ds-card-number\" aria-hidden=\"true\">1</span>描述你的問題</h3><p class=\"ds-card-copy\">加入參考資料，探索不同人的反應與可能走向。</p></section>",
      "css": ".ds-project-card{min-width:0;padding:24px;border:1px solid var(--studio-line,#b4b1a3);border-radius:16px;background:var(--studio-surface,#e4ded2);color:var(--studio-ink,#282b25);font-family:var(--studio-font,system-ui,sans-serif);}.ds-card-title{display:flex;align-items:center;gap:8px;margin:0 0 12px;font-size:1rem;font-weight:700;line-height:1.5}.ds-card-number{display:grid;place-items:center;width:24px;height:24px;border-radius:7px;background:var(--studio-paper,#d5cec1);color:var(--studio-muted,#515548);font-size:12px;font-variant-numeric:tabular-nums}.ds-card-copy{margin:0;color:var(--studio-muted,#515548);font-size:14px;line-height:1.8}@media(max-width:959px){.ds-project-card{padding:20px}}@media(max-width:600px){.ds-project-card{padding:18px 16px}}"
    },
    {
      "name": "工作步驟進度",
      "kind": "nav",
      "refersTo": "workflow-progress",
      "description": "五個工作頁共用的進度標示；目前、已完成與未開始使用不同外觀。",
      "html": "<nav class=\"ds-progress\" aria-label=\"探索流程\"><ol class=\"ds-progress-list\"><li class=\"ds-progress-passed\"><span class=\"ds-progress-number\">✓</span><span>建立圖譜</span></li><li class=\"ds-progress-current\" aria-current=\"step\"><span class=\"ds-progress-number\">02</span><span>設定模擬</span></li><li><span class=\"ds-progress-number\">03</span><span>執行模擬</span></li><li><span class=\"ds-progress-number\">04</span><span>分析報告</span></li><li><span class=\"ds-progress-number\">05</span><span>互動對話</span></li></ol></nav>",
      "css": ".ds-progress{padding:15px 24px;background:var(--studio-paper,#d5cec1);border-bottom:1px solid var(--studio-line,#b4b1a3);font-family:var(--studio-font,system-ui,sans-serif);}.ds-progress-list{display:flex;list-style:none;max-width:920px;margin:0 auto;padding:0}.ds-progress-list li{display:flex;align-items:center;gap:9px;flex:1;font-size:13px;font-weight:600;color:var(--studio-muted,#515548);white-space:nowrap}.ds-progress-number{display:grid;place-items:center;width:28px;height:28px;flex-shrink:0;border:1px solid var(--studio-line,#b4b1a3);border-radius:50%;font-size:11px}.ds-progress-list .ds-progress-current{color:var(--studio-accent,#805014)}.ds-progress-current .ds-progress-number{color:var(--theme-on-filled,#f5efdf);background:var(--studio-accent,#805014);border-color:var(--studio-accent,#805014)}.ds-progress-passed .ds-progress-number{background:var(--theme-success-surface,#d4dfcf);border-color:var(--theme-success-line,#849b7d);color:var(--studio-green,#355b40)}:host-context([data-theme='dark']) .ds-progress-current .ds-progress-number{color:#24251d}@media(max-width:680px){.ds-progress{padding:12px 14px}.ds-progress-list li{justify-content:center;gap:7px}.ds-progress-list li:not(.ds-progress-current)>span:last-child{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.ds-progress-number{width:26px;height:26px}}.ds-progress-list li:last-child{flex:0}.ds-progress-list li:not(:last-child)::after{content:'';height:1px;background:var(--theme-surface-raised,#c7c5b6);flex:1;margin:0 18px}@media(max-width:1050px){.ds-progress-list li:not(:last-child)::after{margin:0 8px}}@media(max-width:680px){.ds-progress-list{gap:6px}.ds-progress-list li:last-child{flex:1}.ds-progress-list .ds-progress-current{flex:0 0 auto;padding-right:5px}.ds-progress-list li:not(:last-child)::after{display:none}}"
    },
    {
      "name": "直向三階段流程",
      "kind": "custom",
      "refersTo": "journey-caption",
      "description": "既有 research-journey-v2.webp 由 CSS 裁成三個場景；桌面左欄依序排列，原生文字在每個場景右側。預覽用相同素材路徑與裁切方式。",
      "html": "<section class=\"ds-journey\" aria-labelledby=\"ds-journey-title\"><h2 class=\"ds-journey-title\" id=\"ds-journey-title\">從資料，看見不同觀點</h2><ol class=\"ds-journey-stages\"><li style=\"--stage-index:0\"><span class=\"ds-journey-artwork\" aria-hidden=\"true\"><img src=\"/assets/visuals/research-journey-v2.webp\" alt=\"\" width=\"880\" height=\"440\" decoding=\"async\" /></span><div class=\"ds-journey-stage-copy\"><strong>參考資料</strong><span>網頁或檔案</span></div><svg class=\"ds-journey-connector\" viewBox=\"0 0 16 28\" aria-hidden=\"true\"><path d=\"M8 1v24m-4-5 4 5 4-5\"/></svg></li><li style=\"--stage-index:1\"><span class=\"ds-journey-artwork\" aria-hidden=\"true\"><img src=\"/assets/visuals/research-journey-v2.webp\" alt=\"\" width=\"880\" height=\"440\" decoding=\"async\" /></span><div class=\"ds-journey-stage-copy\"><strong>人物與互動</strong><span>關係與可能反應</span></div><svg class=\"ds-journey-connector\" viewBox=\"0 0 16 28\" aria-hidden=\"true\"><path d=\"M8 1v24m-4-5 4 5 4-5\"/></svg></li><li style=\"--stage-index:2\"><span class=\"ds-journey-artwork\" aria-hidden=\"true\"><img src=\"/assets/visuals/research-journey-v2.webp\" alt=\"\" width=\"880\" height=\"440\" decoding=\"async\" /></span><div class=\"ds-journey-stage-copy\"><strong>分析報告</strong><span>觀察與依據</span></div></li></ol><p class=\"ds-journey-note\">流程示意。模擬提供可能情境，並非未來的預測。</p></section>",
      "css": ".ds-journey{min-width:0;max-width:320px;color:var(--studio-ink,#282b25);font-family:var(--studio-font,system-ui,sans-serif);}.ds-journey-title{margin:0;font-size:1.25rem;line-height:1.45;font-weight:700;text-wrap:balance}.ds-journey-stages{--artwork-size:116px;display:grid;gap:28px;padding:0;margin:24px 0 0;list-style:none}.ds-journey-stages li{position:relative;min-width:0;display:grid;grid-template-columns:var(--artwork-size) minmax(0,1fr);align-items:center;gap:16px}.ds-journey-artwork{position:relative;display:block;width:var(--artwork-size);height:var(--artwork-size);overflow:hidden}.ds-journey-artwork img{position:absolute;top:50%;left:calc(var(--stage-index) * -100%);display:block;width:300%;max-width:none;height:auto;transform:translateY(-50%)}.ds-journey-stage-copy{min-width:0;overflow-wrap:anywhere}.ds-journey-stage-copy strong{display:block;font-size:1rem;line-height:1.5;font-weight:600}.ds-journey-stage-copy span{display:block;margin-top:4px;color:var(--studio-muted,#515548);font-size:.875rem;line-height:1.75}.ds-journey-connector{position:absolute;top:100%;left:calc(var(--artwork-size) / 2 - 8px);width:16px;height:28px;fill:none;stroke:var(--studio-accent,#805014);stroke-width:1.25;stroke-linecap:round;stroke-linejoin:round}.ds-journey-note{color:var(--studio-muted,#515548);font-size:.8125rem;line-height:1.75;margin:24px 0 0;max-width:65ch}@media(max-width:959px){.ds-journey{max-width:540px}.ds-journey-stages{--artwork-size:96px;gap:28px;margin-top:20px}}"
    },
    {
      "name": "歷史紀錄清單列",
      "kind": "custom",
      "refersTo": "history-row",
      "description": "緊湊回放入口的外觀範例；問題與時間是示例內容。",
      "html": "<div class=\"ds-history-list\"><div class=\"ds-history-row\" role=\"button\" tabindex=\"0\" aria-label=\"查看咖啡店延長營業的可能反應\"><div class=\"ds-history-content\"><h3 class=\"ds-history-title\">咖啡店延長營業的可能反應</h3><div class=\"ds-history-meta\"><time datetime=\"2026-10-03T10:00:00\">2026-10-03 10:00</time><span class=\"ds-history-completed\">已完成 · 2/2 輪</span><span class=\"ds-history-completed\">報告可查看</span></div><p class=\"ds-history-files\">參考資料.md</p></div><span class=\"ds-history-open\" aria-hidden=\"true\">查看回放 <span>→</span></span></div></div>",
      "css": ".ds-history-list{border-block:1px solid var(--studio-line,#b4b1a3);font-family:var(--studio-font,system-ui,sans-serif);color:var(--studio-ink,#282b25)}.ds-history-row{display:flex;align-items:center;gap:24px;min-height:100px;padding:18px 12px;cursor:pointer;transition:background-color .15s ease}.ds-history-row+.ds-history-row{border-top:1px solid var(--studio-line,#b4b1a3)}.ds-history-row:hover{background:var(--theme-surface-soft,#d9d5c9)}.ds-history-row:focus-visible{outline:3px solid var(--studio-accent,#805014);outline-offset:3px}.ds-history-content{flex:1;min-width:0}.ds-history-title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;margin:0 0 7px;font-size:16px;line-height:1.65;font-weight:600;overflow-wrap:anywhere}.ds-history-meta{display:flex;flex-wrap:wrap;gap:4px 14px;color:var(--studio-muted,#515548);font-size:12px;line-height:1.8}.ds-history-meta time{font-variant-numeric:tabular-nums}.ds-history-completed{color:var(--studio-green,#355b40)}.ds-history-files{margin:5px 0 0;color:var(--studio-muted,#515548);font-size:12px;line-height:1.6;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-history-open{display:inline-flex;align-items:center;gap:12px;flex-shrink:0;min-height:44px;color:var(--studio-accent,#805014);font-size:13px}@media(max-width:540px){.ds-history-row{align-items:flex-start;gap:10px;padding:16px 4px}.ds-history-open{font-size:12px;gap:4px}.ds-history-title{font-size:15px}}@media(prefers-reduced-motion:reduce){.ds-history-row{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "暖石探索工作室",
    "overview": "MiroFish 的視覺像一張整理思路的工作桌：暖石色與炭灰色提供安定的底，琥珀色指向目前重點。文件、人物關係與報告以可辨識的圖像連起來，讓第一次使用的人也能理解資料如何變成可追問的結果。\n\n介面以清楚、沉穩、易操作為主。圖示、示意圖與簡短文字共同說明工作；進一步的細節可在需要時展開。淺色與深色共用同一套層次與狀態語意，並支援跟隨系統；繁體中文、簡體中文與英文都必須保留完整內容與可讀排版。\n\n本輪依 Home.vue、ExplorationJourney.vue 與 WebSources.vue 同步設計約束；此資料不代表本輪瀏覽器驗證已完成。",
    "keyCharacteristics": [
      "暖石、炭灰與琥珀色，保留清楚的文字和邊界。",
      "圖像與短句一起解釋資料、關係、模擬與報告。",
      "以底色、細邊框與留白分層，陰影只作輔助。",
      "可收合說明，但保留既有操作、進度、錯誤和復原入口。",
      "深淺外觀、三種語言與鍵盤操作採相同的設計標準。"
    ],
    "rules": [
      {
        "name": "The Amber Focus Rule",
        "body": "琥珀色用於目前步驟、選取、焦點與需要注意的狀態；同層級的一般資訊維持中性色。",
        "section": "colors"
      },
      {
        "name": "The Shared Theme Rule",
        "body": "新元件使用既有語意色彩變數，深色與淺色同步設計；不要只替單一頁面硬編一套色票。",
        "section": "colors"
      },
      {
        "name": "The Readable Language Rule",
        "body": "文字容器必須容納繁體中文、簡體中文與英文；讓內容換行，並保留圖示操作的可讀名稱。",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "大部分表面先以底色和邊框分層；焦點、選取與浮層才加強外框或陰影。",
        "section": "elevation"
      },
      {
        "name": "The Home Layout Rule",
        "body": "首頁寬度至少 960px 時，左欄以 320px 為目標（minmax(280px, 320px)），放置直向三階段流程，右欄放表單，欄距 40px；小於 960px 時表單在先、流程在後，區塊間距 32px。原生內容順序保留表單在流程之前。",
        "section": "layout"
      },
      {
        "name": "The Home Navigation Rule",
        "body": "首頁頁首保留品牌、歷史、語言與偏好入口，移除 GitHub 連結。",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** 延用炭灰、暖石與琥珀色的共同主題，讓一般文字、次要說明和邊框都能清楚辨識。",
